    "def convert_labels(labels):\n",
    "    # Convert string labels to integers\n",
    "    label_map = {}\n",
    "    label_map['sand'] = 0\n",
    "    label_map['gravel'] = 1\n",
    "    label_map['concrete'] = 2\n",
    "    return np.array([label_map[label] for label in labels], dtype=int)"
